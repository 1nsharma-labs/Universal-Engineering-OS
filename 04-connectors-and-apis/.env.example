# ==============================================================================
# Universal Dev Hub - Master Environment Template
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=info

# --- RELATIONAL & VECTOR DATABASES ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub_secure_pass
POSTGRES_DB=devhub_db
POSTGRES_URL=postgresql://devhub:devhub_secure_pass@localhost:5432/devhub_db

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=devhub_root_pass
MYSQL_DATABASE=devhub_db
MYSQL_USER=devhub
MYSQL_PASSWORD=devhub_pass

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=devhub
MONGO_INITDB_ROOT_PASSWORD=devhub_mongo_pass
MONGO_URI=mongodb://devhub:devhub_mongo_pass@localhost:27017/devhub_db?authSource=admin

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devhub_redis_pass
REDIS_URL=redis://:devhub_redis_pass@localhost:6379/0

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
MILVUS_URL=http://localhost:19530

# --- MESSAGE BROKERS & STORAGE ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=devhub
RABBITMQ_PASS=devhub_rabbit_pass

KAFKA_BROKERS=localhost:9092

MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=devhub_admin
MINIO_ROOT_PASSWORD=devhub_minio_secret

# --- AI & CLOUD LLM PROVIDERS ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_TOKEN=your_huggingface_token_here

# --- LOCAL INFERENCE SERVICES ---
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8000/v1
LOCALAI_BASE_URL=http://localhost:8089/v1
WHISPER_ENDPOINT=http://localhost:9000
COMFYUI_ENDPOINT=http://localhost:8188

# --- SAAS & CLOUD SDKS ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
STRIPE_SECRET_KEY=sk_test_your_stripe_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# --- OBSERVABILITY & MONITORING ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://localhost:3002
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
